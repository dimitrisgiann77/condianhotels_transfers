<%- include('partials/header') %>
  <% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>

  <div class="tabs" id="adminTabs">
    <button type="button" data-tab="overview" class="active">Επισκόπηση</button>
    <button type="button" data-tab="routes">Δρομολόγια</button>
    <button type="button" data-tab="users">Χρήστες & Οδηγοί</button>
    <button type="button" data-tab="questions">Ερωτήματα</button>
    <button type="button" data-tab="comm">Επικοινωνία</button>
    <button type="button" data-tab="feedback">Αναφορές<% if (typeof feedback!=='undefined' && feedback.filter(function(f){return f.status==='open'}).length){ %> <span class="badge off"><%= feedback.filter(function(f){return f.status==='open'}).length %></span><% } %></button>
    <% if (user.role === 'admin') { %><button type="button" data-tab="appearance">Εμφάνιση</button><% } %>
  </div>

  <!-- ============ ΕΠΙΣΚΟΠΗΣΗ ============ -->
  <div class="tab active" id="tab-overview">
    <div class="card">
      <h1>Διαχείριση</h1>
      <h2>Αποστολή email (χειροκίνητα / δοκιμή)</h2>
      <div class="row">
        <form method="post" action="/admin/send/staff" class="inline">
          <input type="date" name="date" value="<%= tomorrow %>" />
          <button class="btn">Υπενθύμιση προσωπικού</button>
        </form>
        <form method="post" action="/admin/send/driver" class="inline">
          <input type="date" name="date" value="<%= tomorrow %>" />
          <button class="btn">Email οδηγών</button>
        </form>
      </div>
      <p class="muted small">Αυτόματα: προσωπικό 18:00, οδηγοί 23:00 (ώρα Ελλάδας).</p>
      <h3>Δοκιμαστικό email</h3>
      <form method="post" action="/admin/test-email" class="row">
        <input name="email" type="email" placeholder="email για δοκιμή" required style="min-width:240px" />
        <button class="btn">Αποστολή δοκιμής</button>
      </form>
      <p class="muted small">Στέλνει ένα δοκιμαστικό μήνυμα στη διεύθυνση που θα βάλεις και δείχνει εδώ το αποτέλεσμα/σφάλμα.</p>
    </div>

    <div class="card">
      <h2>Εγκρίσεις εγγραφών (<%= pendingUsers.length %>)</h2>
      <% if (pendingUsers.length === 0) { %>
        <p class="muted">Δεν υπάρχουν εκκρεμείς εγγραφές.</p>
      <% } else { %>
        <table class="tbl">
          <thead><tr><th>Όνομα</th><th>Username</th><th>Email</th><th>Κινητό</th><th>Ρόλος</th><th></th></tr></thead>
          <tbody>
          <% pendingUsers.forEach(function(u){ %>
            <tr>
              <td><%= u.name %></td><td><%= u.username %></td><td><%= u.email||'' %></td><td><%= u.phone||'' %></td><td><%= u.role %></td>
              <td class="nowrap">
                <form method="post" action="/admin/user/<%= u.id %>/approve" class="inline"><button class="link">Έγκριση</button></form>
                <form method="post" action="/admin/user/<%= u.id %>/reject" class="inline" onsubmit="return confirm('Απόρριψη & διαγραφή;')"><button class="link danger">Απόρριψη</button></form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <h2>Ερωτήματα προσωπικού</h2>
      <% var unanswered = questions.filter(function(q){return !q.answer;}).length; %>
      <p>Αναπάντητα: <b class="warn"><%= unanswered %></b> · Σύνολο: <%= questions.length %></p>
      <% questions.slice(0,3).forEach(function(q){ %>
        <div class="decl"><div><div class="d-date"><%= q.person %></div><div class="d-meta"><%= q.message.length>80 ? q.message.slice(0,80)+'…' : q.message %></div></div><span class="badge <%= q.answer?'work':'off' %>"><%= q.answer?'Απαντημένο':'Νέο' %></span></div>
      <% }) %>
      <% if (questions.length===0) { %><p class="muted">Κανένα ερώτημα.</p><% } %>
      <button type="button" class="btn" onclick="adminActivate('questions')">Όλα τα ερωτήματα</button>
    </div>
  </div>

  <!-- ============ ΔΡΟΜΟΛΟΓΙΑ ============ -->
  <div class="tab" id="tab-routes">
    <div class="card">
      <h2>Σειρά εμφάνισης δρομολογίων</h2>
      <p class="muted small">Σύρε τις γραμμές για αναδιάταξη (ή χρησιμοποίησε ▲▼) και πάτα «Αποθήκευση σειράς».</p>
      <ul id="routeOrder" class="sortlist">
        <% routes.forEach(function(r){ %>
          <li draggable="true" data-id="<%= r.id %>"><span class="grip">≡</span><span><%= r.name %></span><span class="ord-btns"><button type="button" onclick="moveRow(this,-1)">▲</button><button type="button" onclick="moveRow(this,1)">▼</button></span></li>
        <% }) %>
      </ul>
      <button class="btn primary" type="button" onclick="saveOrder()">Αποθήκευση σειράς</button>
      <span id="orderMsg" class="muted small" style="margin-left:8px"></span>
    </div>

    <div class="card">
      <h2>Δρομολόγια & στάσεις</h2>
      <% routes.forEach(function(r){ %>
        <div class="route">
          <div class="route-head">
            <form method="post" action="/admin/route/<%= r.id %>/rename" class="inline">
              <input name="name" value="<%= r.name %>" style="width:auto;min-width:220px;font-weight:bold" />
              <button class="link">Μετονομασία</button>
            </form>
            <span class="badge <%= r.active ? 'on':'off' %>"><%= r.active ? 'Ενεργό':'Ανενεργό' %></span>
            <form method="post" action="/admin/route/<%= r.id %>/toggle" class="inline"><button class="link"><%= r.active ? 'Απενεργοποίηση' : 'Ενεργοποίηση' %></button></form>
            <form method="post" action="/admin/route/<%= r.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή δρομολογίου και στάσεων;')"><button class="link danger">Διαγραφή</button></form>
            <form method="post" action="/admin/route/<%= r.id %>/capacity" class="inline" style="margin-left:auto">
              <span class="muted small">Θέσεις:</span>
              <input name="capacity" type="number" min="1" value="<%= r.capacity %>" style="width:64px" />
              <button class="link">Αποθήκευση</button>
            </form>
          </div>
          <table class="tbl">
            <thead><tr><th></th><th>Στάση</th><th>Ώρα</th><th>Πινέζα</th><th></th></tr></thead>
            <tbody class="sortrows" data-route-id="<%= r.id %>">
            <% r.stops.forEach(function(s){ %>
              <tr draggable="true" data-stop-id="<%= s.id %>">
                <td class="grip">≡</td>
                <td><%= s.name %></td>
                <td><%= s.pickup_time || '' %></td>
                <td><%= (s.lat!=null && s.lng!=null) ? '✓' : '—' %></td>
                <td class="nowrap">
                  <button type="button" class="ord-mini" onclick="moveRow(this,-1)">▲</button>
                  <button type="button" class="ord-mini" onclick="moveRow(this,1)">▼</button>
                  <a class="link" href="/admin?stop=<%= s.id %>#stopForm">Επεξεργασία</a>
                  <form method="post" action="/admin/stop/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή στάσης;')"><button class="link danger">×</button></form>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      <% }) %>

      <div style="margin:8px 0">
        <button class="btn" type="button" onclick="saveStopsOrder()">Αποθήκευση σειράς στάσεων</button>
        <span id="stopsMsg" class="muted small" style="margin-left:8px"></span>
      </div>

      <h3>Νέο δρομολόγιο</h3>
      <form method="post" action="/admin/route" class="row">
        <input name="name" placeholder="Όνομα δρομολογίου" required />
        <input name="sort_order" type="number" placeholder="Σειρά" style="width:90px" />
        <input name="capacity" type="number" placeholder="Θέσεις" value="8" style="width:90px" />
        <button class="btn primary">Προσθήκη</button>
      </form>
    </div>

    <div class="card" id="stopForm">
      <h2><%= editStop ? 'Επεξεργασία στάσης' : 'Νέα στάση' %></h2>
      <form method="post" action="<%= editStop ? '/admin/stop/'+editStop.id : '/admin/stop' %>">
        <label>Δρομολόγιο</label>
        <select name="route_id" required>
          <% routes.forEach(function(r){ %><option value="<%= r.id %>" <%= editStop && editStop.route_id===r.id ? 'selected':'' %>><%= r.name %></option><% }) %>
        </select>
        <div class="grid2">
          <div><label>Όνομα στάσης</label><input name="name" value="<%= editStop ? editStop.name : '' %>" required /></div>
          <div><label>Ώρα (π.χ. 06:05)</label><input name="pickup_time" value="<%= editStop ? (editStop.pickup_time||'') : '' %>" /></div>
          <div><label>Σειρά</label><input name="sort_order" type="number" value="<%= editStop ? editStop.sort_order : 0 %>" /></div>
        </div>
        <label>Διεύθυνση (auto-εύρεση πινέζας)</label>
        <div class="row">
          <input id="geoAddr" placeholder="π.χ. Κοκκίνη Χάνι, Ηράκλειο" style="flex:1" />
          <button type="button" class="btn" onclick="geocodeStopAddress()">Βρες στον χάρτη</button>
        </div>
        <div id="geoMsg" class="muted small"></div>
        <label>Θέση πινέζας — ή κάνε κλικ στον χάρτη</label>
        <div id="adminMap" class="map"></div>
        <div class="grid2">
          <div><label>Lat</label><input id="stopLat" name="lat" value="<%= editStop && editStop.lat!=null ? editStop.lat : '' %>" readonly /></div>
          <div><label>Lng</label><input id="stopLng" name="lng" value="<%= editStop && editStop.lng!=null ? editStop.lng : '' %>" readonly /></div>
        </div>
        <p class="muted small">Κάνε κλικ στον χάρτη ή χρησιμοποίησε «Βρες στον χάρτη». Δωρεάν χάρτης OpenStreetMap.</p>
        <button class="btn primary"><%= editStop ? 'Αποθήκευση' : 'Προσθήκη στάσης' %></button>
        <% if (editStop) { %><a class="btn" href="/admin#stopForm">Άκυρο</a><% } %>
      </form>
    </div>
  </div>

  <!-- ============ ΧΡΗΣΤΕΣ & ΟΔΗΓΟΙ ============ -->
  <div class="tab" id="tab-users">
    <% if (user.role === 'admin') { %>
    <div class="card">
      <h2>Κωδικός εγγραφής</h2>
      <p class="muted small">Όρισε κωδικό για να εγγράφεται το προσωπικό στο <code>/register</code>. Κενό = απενεργοποίηση εγγραφής.</p>
      <form method="post" action="/admin/registration-code" class="row">
        <input name="reg_code" value="<%= regCode || '' %>" placeholder="π.χ. CONDIAN2026" style="min-width:240px" />
        <button class="btn">Αποθήκευση</button>
      </form>
    </div>

    <div class="card">
      <h2>Χρήστες</h2>
      <table class="tbl">
        <thead><tr><th>Όνομα</th><th>Ρόλος</th><th>Ξενοδοχείο</th><th>Υπεύθυνος</th><th>Ενεργός</th><th></th></tr></thead>
        <tbody>
        <% users.forEach(function(u){ %>
          <tr>
            <td><a class="who-link" onclick="showContact(this)" data-name="<%= u.name %>" data-email="<%= u.email||'' %>" data-phone="<%= u.phone||'' %>" data-extra="<%= u.role %><%= u.hotel ? ' · '+u.hotel : '' %>"><%= u.name %></a><div class="muted small"><%= u.username %></div></td>
            <td><%= u.role %></td>
            <td><%= u.hotel || '' %></td>
            <td><%= u.supervisor_name || '' %></td>
            <td><%= u.active ? 'Ναι':'Όχι' %></td>
            <td class="nowrap acts">
              <a class="iconbtn" title="Ιστορικό/δραστηριότητα" href="/admin/user/<%= u.id %>/activity"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></a>
              <a class="iconbtn" title="Επεξεργασία" href="/admin?user=<%= u.id %>&tab=users#userEdit"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></a>
              <form method="post" action="/admin/user/<%= u.id %>/toggle" class="inline"><button class="iconbtn" title="<%= u.active?'Απενεργοποίηση':'Ενεργοποίηση' %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v10"/><path d="M5.6 6.6a9 9 0 1 0 12.8 0"/></svg></button></form>
              <form method="post" action="/admin/user/<%= u.id %>/password" class="inline" onsubmit="return promptPw(this)"><input type="hidden" name="password" /><button class="iconbtn" title="Αλλαγή κωδικού"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 20 3"/><path d="M16 7l3 3"/></svg></button></form>
              <form method="post" action="/admin/user/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή χρήστη;')"><button class="iconbtn danger" title="Διαγραφή"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/></svg></button></form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>

      <h3>Νέος χρήστης</h3>
      <form method="post" action="/admin/user" class="grid2">
        <div><label>Επώνυμο</label><input name="last_name" required /></div>
        <div><label>Όνομα</label><input name="first_name" required /></div>
        <div><label>Username</label><input name="username" required /></div>
        <div><label>Κωδικός</label><input name="password" required /></div>
        <div><label>Email *</label><input name="email" type="email" required /></div>
        <div><label>Κινητό *</label><input name="phone" required /></div>
        <div><label>Ξενοδοχείο</label>
          <select name="hotel"><option value="">—</option><% hotels.forEach(function(hh){ %><option value="<%= hh %>"><%= hh %></option><% }) %></select>
        </div>
        <div><label>Υπεύθυνος</label>
          <select name="supervisor_id"><option value="">—</option><% supervisors.forEach(function(sp){ %><option value="<%= sp.id %>"><%= sp.name %> (<%= sp.role %>)</option><% }) %></select>
        </div>
        <div><label>Ρόλος</label>
          <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="superuser">Superuser</option><option value="admin">Admin</option></select>
        </div>
        <div class="end"><button class="btn primary">Προσθήκη</button></div>
      </form>
    </div>

    <% if (editUser) { %>
    <div class="card" id="userEdit">
      <h2>Επεξεργασία: <%= editUser.name %></h2>
      <form method="post" action="/admin/user/<%= editUser.id %>/edit" class="grid2">
        <div><label>Επώνυμο</label><input name="last_name" value="<%= editUser.last_name || '' %>" /></div>
        <div><label>Όνομα</label><input name="first_name" value="<%= editUser.first_name || '' %>" /></div>
        <div><label>Email *</label><input name="email" type="email" value="<%= editUser.email || '' %>" required /></div>
        <div><label>Κινητό *</label><input name="phone" value="<%= editUser.phone || '' %>" required /></div>
        <div><label>Ξενοδοχείο</label><select name="hotel"><option value="">—</option><% hotels.forEach(function(hh){ %><option value="<%= hh %>" <%= editUser.hotel===hh?'selected':'' %>><%= hh %></option><% }) %></select></div>
        <div><label>Υπεύθυνος</label><select name="supervisor_id"><option value="">—</option><% supervisors.forEach(function(sp){ %><option value="<%= sp.id %>" <%= editUser.supervisor_id===sp.id?'selected':'' %>><%= sp.name %> (<%= sp.role %>)</option><% }) %></select></div>
        <div><label>Ρόλος</label><select name="role"><% ['staff','driver','superuser','admin'].forEach(function(rr){ %><option value="<%= rr %>" <%= editUser.role===rr?'selected':'' %>><%= rr %></option><% }) %></select></div>
        <div class="end"><button class="btn primary">Αποθήκευση</button> <a class="btn" href="/admin?tab=users">Άκυρο</a></div>
      </form>
    </div>
    <% } %>

    <div class="card">
      <h2>Ξενοδοχεία</h2>
      <p class="muted small">Μία ανά γραμμή (ή με κόμμα). Εμφανίζονται ως επιλογές στους χρήστες.</p>
      <form method="post" action="/admin/hotels">
        <textarea name="hotels" rows="5" style="width:100%"><%= hotels.join('\n') %></textarea>
        <button class="btn primary">Αποθήκευση ξενοδοχείων</button>
      </form>
    </div>

    <div class="card">
      <h2>Μαζική εισαγωγή χρηστών</h2>
      <p class="muted small">Συμπλήρωσε όσες γραμμές θες και πάτα «Εισαγωγή όλων». Γραμμές χωρίς username/κωδικό αγνοούνται.</p>
      <form method="post" action="/admin/user/bulk">
        <div id="bulkRows">
          <% for (var bi=0; bi<5; bi++) { %>
          <div class="grid2" style="margin-bottom:6px">
            <input name="last_name" placeholder="Επώνυμο" />
            <input name="first_name" placeholder="Όνομα" />
            <input name="username" placeholder="Username" />
            <input name="password" placeholder="Κωδικός" />
            <input name="email" placeholder="Email" />
            <input name="phone" placeholder="Κινητό" />
            <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="superuser">Superuser</option><option value="admin">Admin</option></select>
          </div>
          <% } %>
        </div>
        <button type="button" class="btn" onclick="addBulkRow()">+ Προσθήκη γραμμής</button>
        <button class="btn primary">Εισαγωγή όλων</button>
      </form>
      <template id="bulkTpl">
        <div class="grid2" style="margin-bottom:6px">
          <input name="last_name" placeholder="Επώνυμο" />
          <input name="first_name" placeholder="Όνομα" />
          <input name="username" placeholder="Username" />
          <input name="password" placeholder="Κωδικός" />
          <input name="email" placeholder="Email" />
          <input name="phone" placeholder="Κινητό" />
          <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="superuser">Superuser</option><option value="admin">Admin</option></select>
        </div>
      </template>
    </div>
    <% } %>

    <div class="card">
      <h2>Δρομολόγια ανά οδηγό</h2>
      <% drivers.forEach(function(d){ var assigned=(driverRoutes[d.id]||[]); %>
        <form method="post" action="/admin/driver/<%= d.id %>/routes" class="driver-assign">
          <div class="da-head">
            <strong><a class="who-link" onclick="showContact(this)" data-name="<%= d.name %>" data-email="<%= d.email||'' %>" data-phone="<%= d.phone||'' %>" data-extra="οδηγός"><%= d.name %></a></strong>
            <span class="muted small">Καλύπτει <%= assigned.length %> δρομολόγια</span>
            <button class="btn" style="margin-left:auto">Αποθήκευση</button>
          </div>
          <div class="checks2">
            <% routes.forEach(function(r){ %>
              <label class="chk"><input type="checkbox" name="route_ids" value="<%= r.id %>" <%= assigned.includes(r.id) ? 'checked':'' %>> <%= r.name %></label>
            <% }) %>
          </div>
        </form>
      <% }) %>
      <% if (drivers.length === 0) { %><p class="muted">Δεν υπάρχουν οδηγοί ακόμη.</p><% } %>
    </div>
  </div>

  <!-- ============ ΕΡΩΤΗΜΑΤΑ ============ -->
  <div class="tab" id="tab-questions">
    <div class="card">
      <h1>Ερωτήματα προσωπικού</h1>
      <% if (questions.length === 0) { %><p class="muted">Δεν υπάρχουν ερωτήματα.</p><% } %>
      <% questions.forEach(function(q){ %>
        <div class="route">
          <div class="route-head">
            <strong><%= q.person %></strong>
            <span class="muted small"><%= q.person_email || '' %> · <%= new Date(q.created_at).toLocaleString('el-GR') %></span>
            <% if (!q.answer) { %><span class="badge off">Αναπάντητο</span><% } else { %><span class="badge on">Απαντήθηκε</span><% } %>
          </div>
          <p style="margin:6px 0"><%= q.message %></p>
          <form method="post" action="/admin/question/<%= q.id %>/answer">
            <label>Απάντηση</label>
            <textarea name="answer" rows="2" style="width:100%;padding:9px 10px;border:1px solid #ccc;border-radius:7px;font-family:inherit;font-size:14px"><%= q.answer || '' %></textarea>
            <button class="btn">Αποθήκευση απάντησης</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ============ ΕΠΙΚΟΙΝΩΝΙΑ ============ -->
  <div class="tab" id="tab-comm">
    <div class="card">
      <h1>Αρχείο επικοινωνίας (emails)</h1>
      <p class="muted small">Τελευταία emails που έστειλε η εφαρμογή (υπενθυμίσεις, προγράμματα οδηγών, δοκιμαστικά).</p>
      <% if (!emailLog || emailLog.length===0) { %>
        <p class="muted">Δεν έχει σταλεί κάποιο email ακόμη.</p>
      <% } else { %>
        <table class="tbl">
          <thead><tr><th>Ημ/νία</th><th>Προς</th><th>Θέμα</th><th>Κατάσταση</th></tr></thead>
          <tbody>
