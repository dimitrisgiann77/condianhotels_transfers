  <script>
    function promptPw(f){ const p = prompt('Νέος κωδικός:'); if(!p) return false; f.password.value = p; return true; }
    function addBulkRow(){var t=document.getElementById('bulkTpl');if(t)document.getElementById('bulkRows').appendChild(t.content.cloneNode(true));}
    window.ADMIN_STOP = <%- JSON.stringify(editStop || null) %>;
    function pv(){
      var p=document.getElementById('themePreview'); if(!p) return;
      var v=function(id){var e=document.getElementById(id);return e?e.value:'';};
      p.style.setProperty('--pv-header-bg',v('header_bg'));
      p.style.setProperty('--pv-header-text',v('header_text'));
      p.style.setProperty('--pv-accent',v('accent'));
      p.style.setProperty('--pv-page-bg',v('page_bg'));
      p.style.setProperty('--pv-card-bg',v('card_bg'));
      p.style.setProperty('--pv-text',v('text'));
      p.style.setProperty('--pv-radius',(v('radius')||'10')+'px');
      p.style.fontFamily=v('font'); p.style.fontSize=(v('font_size')||'15')+'px';
      var b=document.getElementById('pvBtn'); if(b){b.style.background=v('primary'); b.style.color=v('primary_text');}
      var l=document.getElementById('pvLink'); if(l) l.style.color=v('link');
      [document.getElementById('pvTh'),document.getElementById('pvTh2')].forEach(function(th){if(th){th.style.background=v('th_bg');th.style.color=v('th_text');}});
      var f=document.getElementById('pvFoot'); if(f) f.style.color=v('footer_text');
      var tt=document.getElementById('pvTitle'); if(tt){tt.textContent=v('app_title'); var sh=document.getElementById('show_title'); tt.style.display=(sh&&sh.checked)?'':'none';}
    }
    (function(){
      var tabs=document.querySelectorAll('#adminTabs button');
      var sections=document.querySelectorAll('.tab');
      function activate(name){
        if(!document.getElementById('tab-'+name)) name='overview';
        tabs.forEach(function(b){b.classList.toggle('active', b.dataset.tab===name);});
        sections.forEach(function(s){s.classList.toggle('active', s.id==='tab-'+name);});
        if(name==='routes'&&window.refreshAdminMap)window.refreshAdminMap();
        try{localStorage.setItem('adminTab',name);}catch(e){}
      }
      tabs.forEach(function(b){b.addEventListener('click',function(){activate(b.dataset.tab);});});
      window.adminActivate=activate;
      var initial='overview';
      var qp=new URLSearchParams(location.search).get('tab');
      if(qp) initial=qp;
      else if(window.ADMIN_STOP) initial='routes';
      else { try{var t=localStorage.getItem('adminTab'); if(t) initial=t;}catch(e){} }
      activate(initial);
      if(window.ADMIN_STOP){var sf=document.getElementById('stopForm'); if(sf) sf.scrollIntoView();}
      pv();
    })();
  </script>
  <script>
    (function(){
      function initSortable(c){
        if(!c) return;
        c.addEventListener('dragover',function(e){
          e.preventDefault();
          var dragging=c.querySelector('.dragging'); if(!dragging)return;
          var items=[].slice.call(c.children).filter(function(x){return x!==dragging && x.getAttribute('draggable')==='true';});
          var after=items.reduce(function(cl,ch){var b=ch.getBoundingClientRect();var off=e.clientY-b.top-b.height/2;if(off<0&&off>cl.offset)return{offset:off,element:ch};return cl;},{offset:-Infinity}).element;
          if(after==null)c.appendChild(dragging);else c.insertBefore(dragging,after);
        });
        [].slice.call(c.children).forEach(function(it){
          if(it.getAttribute('draggable')!=='true')return;
          it.addEventListener('dragstart',function(){it.classList.add('dragging');});
          it.addEventListener('dragend',function(){it.classList.remove('dragging');});
        });
      }
      window.moveRow=function(btn,dir){
        var it=btn.closest('li,tr'); var pp=it.parentNode;
        if(dir<0&&it.previousElementSibling)pp.insertBefore(it,it.previousElementSibling);
        if(dir>0&&it.nextElementSibling)pp.insertBefore(it.nextElementSibling,it);
      };
      function post(url,body,msgId){var m=document.getElementById(msgId);if(m)m.textContent='Αποθήκευση…';
        fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json();}).then(function(){if(m)m.textContent='Αποθηκεύτηκε ✓ (ανανέωσε για ενημέρωση)';}).catch(function(){if(m)m.textContent='Σφάλμα';});}
      initSortable(document.getElementById('routeOrder'));
      [].slice.call(document.querySelectorAll('tbody.sortrows')).forEach(initSortable);
      window.saveOrder=function(){var l=document.getElementById('routeOrder');if(!l)return;var ids=[].slice.call(l.querySelectorAll('li')).map(function(li){return li.dataset.id;});post('/admin/routes/reorder',{ids:ids},'orderMsg');};
      window.saveStopsOrder=function(){var orders=[].slice.call(document.querySelectorAll('tbody.sortrows')).map(function(tb){return [].slice.call(tb.querySelectorAll('tr')).map(function(tr){return tr.dataset.stopId;});});post('/admin/stops/reorder',{orders:orders},'stopsMsg');};
    })();
  </script>
