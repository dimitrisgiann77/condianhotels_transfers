<%- include('partials/header') %>
  <% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>

  <div class="card">
    <h1>Διαχείριση</h1>
    <h2>Αποστολή email (χειροκίνητα / δοκιμή)</h2>
    <div class="row">
      <form method="post" action="/admin/send/staff" class="inline">
        <input type="date" name="date" value="<%= tomorrow %>" />
        <button class="btn">Υπενθύμιση προσωπικού</button>
      </form>
      <form method="post" action="/admin/send/driver" class="inline">
        <input type="date" name="date" value="<%= tomorrow %>" />
        <button class="btn">Email οδηγών</button>
      </form>
    </div>
    <p class="muted small">Αυτόματα: προσωπικό 18:00, οδηγοί 23:00 (ώρα Ελλάδας).</p>
  </div>

  <div class="card">
    <h2>Branding — Χρώματα & Λογότυπα</h2>
    <form method="post" action="/admin/branding/colors">
      <div class="grid2">
        <div><label>Navy (μπάρα/τίτλοι)</label><input type="color" name="color_navy" value="<%= colors.navy %>" /></div>
        <div><label>Gold (τονισμοί)</label><input type="color" name="color_gold" value="<%= colors.gold %>" /></div>
        <div><label>Teal</label><input type="color" name="color_teal" value="<%= colors.teal %>" /></div>
        <div><label>Indigo</label><input type="color" name="color_indigo" value="<%= colors.indigo %>" /></div>
        <div><label>Deep teal (links)</label><input type="color" name="color_deep" value="<%= colors.deep %>" /></div>
        <div><label>Steel (focus)</label><input type="color" name="color_steel" value="<%= colors.steel %>" /></div>
      </div>
      <button class="btn primary">Αποθήκευση χρωμάτων</button>
    </form>

    <h3>Λογότυπα (PNG/SVG, έως 3MB)</h3>
    <form method="post" action="/admin/branding/logos" enctype="multipart/form-data">
      <div class="grid2">
        <div><label>Λογότυπο (λευκό φόντο · login)</label><input type="file" name="logo" accept="image/*" /></div>
        <div><label>Λογότυπο (σκούρο φόντο · μπάρα)</label><input type="file" name="logo_white" accept="image/*" /></div>
        <div><label>Favicon / εικονίδιο</label><input type="file" name="favicon" accept="image/*" /></div>
      </div>
      <button class="btn primary">Ανέβασμα λογοτύπων</button>
    </form>
    <p class="muted small">Τρέχοντα:
      <a href="/brand/logo" target="_blank">logo</a> ·
      <a href="/brand/logo-white" target="_blank">logo-white</a> ·
      <a href="/brand/favicon" target="_blank">favicon</a>
    </p>
  </div>

  <div class="card">
    <h2>Δρομολόγια & στάσεις</h2>
    <% routes.forEach(function(r){ %>
      <div class="route">
        <div class="route-head">
          <strong><%= r.name %></strong>
          <span class="badge <%= r.active ? 'on':'off' %>"><%= r.active ? 'Ενεργό':'Ανενεργό' %></span>
          <form method="post" action="/admin/route/<%= r.id %>/toggle" class="inline"><button class="link">Εναλλαγή</button></form>
          <form method="post" action="/admin/route/<%= r.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή δρομολογίου και στάσεων;')"><button class="link danger">Διαγραφή</button></form>
          <form method="post" action="/admin/route/<%= r.id %>/capacity" class="inline" style="margin-left:auto">
            <span class="muted small">Θέσεις:</span>
            <input name="capacity" type="number" min="1" value="<%= r.capacity %>" style="width:64px" />
            <button class="link">Αποθήκευση</button>
          </form>
        </div>
        <table class="tbl">
          <thead><tr><th>#</th><th>Στάση</th><th>Ώρα</th><th>Πινέζα</th><th></th></tr></thead>
          <tbody>
          <% r.stops.forEach(function(s){ %>
            <tr>
              <td><%= s.sort_order %></td>
              <td><%= s.name %></td>
              <td><%= s.pickup_time || '' %></td>
              <td><%= (s.lat!=null && s.lng!=null) ? '✓' : '—' %></td>
              <td>
                <a class="link" href="/admin?stop=<%= s.id %>#stopForm">Επεξεργασία</a>
                <form method="post" action="/admin/stop/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή στάσης;')"><button class="link danger">×</button></form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>

    <h3>Νέο δρομολόγιο</h3>
    <form method="post" action="/admin/route" class="row">
      <input name="name" placeholder="Όνομα δρομολογίου" required />
      <input name="sort_order" type="number" placeholder="Σειρά" style="width:90px" />
      <input name="capacity" type="number" placeholder="Θέσεις" value="9" style="width:90px" />
      <button class="btn primary">Προσθήκη</button>
    </form>
  </div>

  <div class="card" id="stopForm">
    <h2><%= editStop ? 'Επεξεργασία στάσης' : 'Νέα στάση' %></h2>
    <form method="post" action="<%= editStop ? '/admin/stop/'+editStop.id : '/admin/stop' %>">
      <label>Δρομολόγιο</label>
      <select name="route_id" required>
        <% routes.forEach(function(r){ %><option value="<%= r.id %>" <%= editStop && editStop.route_id===r.id ? 'selected':'' %>><%= r.name %></option><% }) %>
      </select>
      <div class="grid2">
        <div><label>Όνομα στάσης</label><input name="name" value="<%= editStop ? editStop.name : '' %>" required /></div>
        <div><label>Ώρα (π.χ. 06:05)</label><input name="pickup_time" value="<%= editStop ? (editStop.pickup_time||'') : '' %>" /></div>
        <div><label>Σειρά</label><input name="sort_order" type="number" value="<%= editStop ? editStop.sort_order : 0 %>" /></div>
      </div>
      <label>Διεύθυνση (auto-εύρεση πινέζας)</label>
      <div class="row">
        <input id="geoAddr" placeholder="π.χ. Κοκκίνη Χάνι, Ηράκλειο" style="flex:1" />
        <button type="button" class="btn" onclick="geocodeStopAddress()">Βρες στον χάρτη</button>
      </div>
      <div id="geoMsg" class="muted small"></div>
      <label>Θέση πινέζας — ή κάνε κλικ στον χάρτη</label>
      <div id="adminMap" class="map"></div>
      <div class="grid2">
        <div><label>Lat</label><input id="stopLat" name="lat" value="<%= editStop && editStop.lat!=null ? editStop.lat : '' %>" readonly /></div>
        <div><label>Lng</label><input id="stopLng" name="lng" value="<%= editStop && editStop.lng!=null ? editStop.lng : '' %>" readonly /></div>
      </div>
      <% if (!mapsKey) { %><p class="muted small">Πρόσθεσε GOOGLE_MAPS_API_KEY για τον χάρτη (μπορείς να βάλεις lat/lng και χειροκίνητα).</p><% } %>
      <button class="btn primary"><%= editStop ? 'Αποθήκευση' : 'Προσθήκη στάσης' %></button>
      <% if (editStop) { %><a class="btn" href="/admin#stopForm">Άκυρο</a><% } %>
    </form>
  </div>

  <div class="card">
    <h2>Χρήστες</h2>
    <table class="tbl">
      <thead><tr><th>Όνομα</th><th>Username</th><th>Email</th><th>Ρόλος</th><th>Ενεργός</th><th></th></tr></thead>
      <tbody>
      <% users.forEach(function(u){ %>
        <tr>
          <td><%= u.name %></td><td><%= u.username %></td><td><%= u.email || '' %></td>
          <td><%= u.role %></td>
          <td><%= u.active ? 'Ναι':'Όχι' %></td>
          <td class="nowrap">
            <form method="post" action="/admin/user/<%= u.id %>/toggle" class="inline"><button class="link">Εναλλαγή</button></form>
            <form method="post" action="/admin/user/<%= u.id %>/password" class="inline" onsubmit="return promptPw(this)">
              <input type="hidden" name="password" />
              <button class="link">Κωδικός</button>
            </form>
            <form method="post" action="/admin/user/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή χρήστη;')"><button class="link danger">×</button></form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>

    <h3>Νέος χρήστης</h3>
    <form method="post" action="/admin/user" class="grid2">
      <div><label>Όνομα</label><input name="name" required /></div>
      <div><label>Email</label><input name="email" type="email" /></div>
      <div><label>Username</label><input name="username" required /></div>
      <div><label>Κωδικός</label><input name="password" required /></div>
      <div><label>Ρόλος</label>
        <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="admin">Admin</option></select>
      </div>
      <div class="end"><button class="btn primary">Προσθήκη</button></div>
    </form>
  </div>

  <div class="card">
    <h2>Δρομολόγια ανά οδηγό</h2>
    <% drivers.forEach(function(d){ %>
      <form method="post" action="/admin/driver/<%= d.id %>/routes" class="driver-assign">
        <strong><%= d.name %></strong>
        <div class="checks">
          <% routes.forEach(function(r){ %>
            <label class="chk"><input type="checkbox" name="route_ids" value="<%= r.id %>" <%= (driverRoutes[d.id]||[]).includes(r.id) ? 'checked':'' %>> <%= r.name %></label>
          <% }) %>
        </div>
        <button class="btn">Αποθήκευση</button>
      </form>
    <% }) %>
    <% if (drivers.length === 0) { %><p class="muted">Δεν υπάρχουν οδηγοί ακόμη.</p><% } %>
  </div>

  <script>
    function promptPw(f){ const p = prompt('Νέος κωδικός:'); if(!p) return false; f.password.value = p; return true; }
    window.ADMIN_STOP = <%- JSON.stringify(editStop || null) %>;
  </script>
  <% if (mapsKey) { %>
    <script src="/admin-map.js"></script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= mapsKey %>&callback=initAdminMap"></script>
  <% } %>
<%- include('partials/footer') %>
