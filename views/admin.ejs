<%- include('partials/header') %>
  <% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>

  <div class="tabs" id="adminTabs">
    <button type="button" data-tab="overview" class="active">Επισκόπηση</button>
    <button type="button" data-tab="routes">Δρομολόγια</button>
    <button type="button" data-tab="users">Χρήστες & Οδηγοί</button>
    <% if (user.role === 'admin') { %><button type="button" data-tab="appearance">Εμφάνιση</button><% } %>
  </div>

  <!-- ============ ΕΠΙΣΚΟΠΗΣΗ ============ -->
  <div class="tab active" id="tab-overview">
    <div class="card">
      <h1>Διαχείριση</h1>
      <h2>Αποστολή email (χειροκίνητα / δοκιμή)</h2>
      <div class="row">
        <form method="post" action="/admin/send/staff" class="inline">
          <input type="date" name="date" value="<%= tomorrow %>" />
          <button class="btn">Υπενθύμιση προσωπικού</button>
        </form>
        <form method="post" action="/admin/send/driver" class="inline">
          <input type="date" name="date" value="<%= tomorrow %>" />
          <button class="btn">Email οδηγών</button>
        </form>
      </div>
      <p class="muted small">Αυτόματα: προσωπικό 18:00, οδηγοί 23:00 (ώρα Ελλάδας).</p>
      <h3>Δοκιμαστικό email</h3>
      <form method="post" action="/admin/test-email" class="row">
        <input name="email" type="email" placeholder="email για δοκιμή" required style="min-width:240px" />
        <button class="btn">Αποστολή δοκιμής</button>
      </form>
      <p class="muted small">Στέλνει ένα δοκιμαστικό μήνυμα στη διεύθυνση που θα βάλεις και δείχνει εδώ το αποτέλεσμα/σφάλμα.</p>
    </div>

    <div class="card">
      <h2>Εγκρίσεις εγγραφών (<%= pendingUsers.length %>)</h2>
      <% if (pendingUsers.length === 0) { %>
        <p class="muted">Δεν υπάρχουν εκκρεμείς εγγραφές.</p>
      <% } else { %>
        <table class="tbl">
          <thead><tr><th>Όνομα</th><th>Username</th><th>Email</th><th>Κινητό</th><th>Ρόλος</th><th></th></tr></thead>
          <tbody>
          <% pendingUsers.forEach(function(u){ %>
            <tr>
              <td><%= u.name %></td><td><%= u.username %></td><td><%= u.email||'' %></td><td><%= u.phone||'' %></td><td><%= u.role %></td>
              <td class="nowrap">
                <form method="post" action="/admin/user/<%= u.id %>/approve" class="inline"><button class="link">Έγκριση</button></form>
                <form method="post" action="/admin/user/<%= u.id %>/reject" class="inline" onsubmit="return confirm('Απόρριψη & διαγραφή;')"><button class="link danger">Απόρριψη</button></form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- ============ ΔΡΟΜΟΛΟΓΙΑ ============ -->
  <div class="tab" id="tab-routes">
    <div class="card">
      <h2>Σειρά εμφάνισης δρομολογίων</h2>
      <p class="muted small">Σύρε τις γραμμές για αναδιάταξη (ή χρησιμοποίησε ▲▼) και πάτα «Αποθήκευση σειράς».</p>
      <ul id="routeOrder" class="sortlist">
        <% routes.forEach(function(r){ %>
          <li draggable="true" data-id="<%= r.id %>"><span class="grip">≡</span><span><%= r.name %></span><span class="ord-btns"><button type="button" onclick="moveRow(this,-1)">▲</button><button type="button" onclick="moveRow(this,1)">▼</button></span></li>
        <% }) %>
      </ul>
      <button class="btn primary" type="button" onclick="saveOrder()">Αποθήκευση σειράς</button>
      <span id="orderMsg" class="muted small" style="margin-left:8px"></span>
    </div>

    <div class="card">
      <h2>Δρομολόγια & στάσεις</h2>
      <% routes.forEach(function(r){ %>
        <div class="route">
          <div class="route-head">
            <form method="post" action="/admin/route/<%= r.id %>/rename" class="inline">
              <input name="name" value="<%= r.name %>" style="width:auto;min-width:220px;font-weight:bold" />
              <button class="link">Μετονομασία</button>
            </form>
            <span class="badge <%= r.active ? 'on':'off' %>"><%= r.active ? 'Ενεργό':'Ανενεργό' %></span>
            <form method="post" action="/admin/route/<%= r.id %>/toggle" class="inline"><button class="link"><%= r.active ? 'Απενεργοποίηση' : 'Ενεργοποίηση' %></button></form>
            <form method="post" action="/admin/route/<%= r.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή δρομολογίου και στάσεων;')"><button class="link danger">Διαγραφή</button></form>
            <form method="post" action="/admin/route/<%= r.id %>/capacity" class="inline" style="margin-left:auto">
              <span class="muted small">Θέσεις:</span>
              <input name="capacity" type="number" min="1" value="<%= r.capacity %>" style="width:64px" />
              <button class="link">Αποθήκευση</button>
            </form>
          </div>
          <table class="tbl">
            <thead><tr><th>#</th><th>Στάση</th><th>Ώρα</th><th>Πινέζα</th><th></th></tr></thead>
            <tbody>
            <% r.stops.forEach(function(s){ %>
              <tr>
                <td><%= s.sort_order %></td>
                <td><%= s.name %></td>
                <td><%= s.pickup_time || '' %></td>
                <td><%= (s.lat!=null && s.lng!=null) ? '✓' : '—' %></td>
                <td>
                  <a class="link" href="/admin?stop=<%= s.id %>#stopForm">Επεξεργασία</a>
                  <form method="post" action="/admin/stop/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή στάσης;')"><button class="link danger">×</button></form>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      <% }) %>

      <h3>Νέο δρομολόγιο</h3>
      <form method="post" action="/admin/route" class="row">
        <input name="name" placeholder="Όνομα δρομολογίου" required />
        <input name="sort_order" type="number" placeholder="Σειρά" style="width:90px" />
        <input name="capacity" type="number" placeholder="Θέσεις" value="9" style="width:90px" />
        <button class="btn primary">Προσθήκη</button>
      </form>
    </div>

    <div class="card" id="stopForm">
      <h2><%= editStop ? 'Επεξεργασία στάσης' : 'Νέα στάση' %></h2>
      <form method="post" action="<%= editStop ? '/admin/stop/'+editStop.id : '/admin/stop' %>">
        <label>Δρομολόγιο</label>
        <select name="route_id" required>
          <% routes.forEach(function(r){ %><option value="<%= r.id %>" <%= editStop && editStop.route_id===r.id ? 'selected':'' %>><%= r.name %></option><% }) %>
        </select>
        <div class="grid2">
          <div><label>Όνομα στάσης</label><input name="name" value="<%= editStop ? editStop.name : '' %>" required /></div>
          <div><label>Ώρα (π.χ. 06:05)</label><input name="pickup_time" value="<%= editStop ? (editStop.pickup_time||'') : '' %>" /></div>
          <div><label>Σειρά</label><input name="sort_order" type="number" value="<%= editStop ? editStop.sort_order : 0 %>" /></div>
        </div>
        <label>Διεύθυνση (auto-εύρεση πινέζας)</label>
        <div class="row">
          <input id="geoAddr" placeholder="π.χ. Κοκκίνη Χάνι, Ηράκλειο" style="flex:1" />
          <button type="button" class="btn" onclick="geocodeStopAddress()">Βρες στον χάρτη</button>
        </div>
        <div id="geoMsg" class="muted small"></div>
        <label>Θέση πινέζας — ή κάνε κλικ στον χάρτη</label>
        <div id="adminMap" class="map"></div>
        <div class="grid2">
          <div><label>Lat</label><input id="stopLat" name="lat" value="<%= editStop && editStop.lat!=null ? editStop.lat : '' %>" readonly /></div>
          <div><label>Lng</label><input id="stopLng" name="lng" value="<%= editStop && editStop.lng!=null ? editStop.lng : '' %>" readonly /></div>
        </div>
        <% if (!mapsKey) { %><p class="muted small">Πρόσθεσε GOOGLE_MAPS_API_KEY για τον χάρτη (μπορείς να βάλεις lat/lng και χειροκίνητα).</p><% } %>
        <button class="btn primary"><%= editStop ? 'Αποθήκευση' : 'Προσθήκη στάσης' %></button>
        <% if (editStop) { %><a class="btn" href="/admin#stopForm">Άκυρο</a><% } %>
      </form>
    </div>
  </div>

  <!-- ============ ΧΡΗΣΤΕΣ & ΟΔΗΓΟΙ ============ -->
  <div class="tab" id="tab-users">
    <% if (user.role === 'admin') { %>
    <div class="card">
      <h2>Κωδικός εγγραφής</h2>
      <p class="muted small">Όρισε κωδικό για να εγγράφεται το προσωπικό στο <code>/register</code>. Κενό = απενεργοποίηση εγγραφής.</p>
      <form method="post" action="/admin/registration-code" class="row">
        <input name="reg_code" value="<%= regCode || '' %>" placeholder="π.χ. CONDIAN2026" style="min-width:240px" />
        <button class="btn">Αποθήκευση</button>
      </form>
    </div>

    <div class="card">
      <h2>Χρήστες</h2>
      <table class="tbl">
        <thead><tr><th>Όνομα</th><th>Username</th><th>Email</th><th>Ρόλος</th><th>Ενεργός</th><th></th></tr></thead>
        <tbody>
        <% users.forEach(function(u){ %>
          <tr>
            <td><%= u.name %></td><td><%= u.username %></td><td><%= u.email || '' %></td>
            <td><%= u.role %></td>
            <td><%= u.active ? 'Ναι':'Όχι' %></td>
            <td class="nowrap">
              <form method="post" action="/admin/user/<%= u.id %>/toggle" class="inline"><button class="link"><%= u.active ? 'Απενεργοποίηση' : 'Ενεργοποίηση' %></button></form>
              <form method="post" action="/admin/user/<%= u.id %>/password" class="inline" onsubmit="return promptPw(this)">
                <input type="hidden" name="password" />
                <button class="link">Κωδικός</button>
              </form>
              <form method="post" action="/admin/user/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Διαγραφή χρήστη;')"><button class="link danger">×</button></form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>

      <h3>Νέος χρήστης</h3>
      <form method="post" action="/admin/user" class="grid2">
        <div><label>Επώνυμο</label><input name="last_name" required /></div>
        <div><label>Όνομα</label><input name="first_name" required /></div>
        <div><label>Username</label><input name="username" required /></div>
        <div><label>Κωδικός</label><input name="password" required /></div>
        <div><label>Email</label><input name="email" type="email" /></div>
        <div><label>Κινητό</label><input name="phone" /></div>
        <div><label>Ρόλος</label>
          <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="superuser">Superuser</option><option value="admin">Admin</option></select>
        </div>
        <div class="end"><button class="btn primary">Προσθήκη</button></div>
      </form>
    </div>

    <div class="card">
      <h2>Μαζική εισαγωγή χρηστών</h2>
      <p class="muted small">Συμπλήρωσε όσες γραμμές θες και πάτα «Εισαγωγή όλων». Γραμμές χωρίς username/κωδικό αγνοούνται.</p>
      <form method="post" action="/admin/user/bulk">
        <div id="bulkRows">
          <% for (var bi=0; bi<5; bi++) { %>
          <div class="grid2" style="margin-bottom:6px">
            <input name="last_name" placeholder="Επώνυμο" />
            <input name="first_name" placeholder="Όνομα" />
            <input name="username" placeholder="Username" />
            <input name="password" placeholder="Κωδικός" />
            <input name="email" placeholder="Email" />
            <input name="phone" placeholder="Κινητό" />
            <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="superuser">Superuser</option><option value="admin">Admin</option></select>
          </div>
          <% } %>
        </div>
        <button type="button" class="btn" onclick="addBulkRow()">+ Προσθήκη γραμμής</button>
        <button class="btn primary">Εισαγωγή όλων</button>
      </form>
      <template id="bulkTpl">
        <div class="grid2" style="margin-bottom:6px">
          <input name="last_name" placeholder="Επώνυμο" />
          <input name="first_name" placeholder="Όνομα" />
          <input name="username" placeholder="Username" />
          <input name="password" placeholder="Κωδικός" />
          <input name="email" placeholder="Email" />
          <input name="phone" placeholder="Κινητό" />
          <select name="role"><option value="staff">Προσωπικό</option><option value="driver">Οδηγός</option><option value="superuser">Superuser</option><option value="admin">Admin</option></select>
        </div>
      </template>
    </div>
    <% } %>

    <div class="card">
      <h2>Δρομολόγια ανά οδηγό</h2>
      <% drivers.forEach(function(d){ %>
        <form method="post" action="/admin/driver/<%= d.id %>/routes" class="driver-assign">
          <strong><%= d.name %></strong>
          <div class="checks">
            <% routes.forEach(function(r){ %>
              <label class="chk"><input type="checkbox" name="route_ids" value="<%= r.id %>" <%= (driverRoutes[d.id]||[]).includes(r.id) ? 'checked':'' %>> <%= r.name %></label>
            <% }) %>
          </div>
          <button class="btn">Αποθήκευση</button>
        </form>
      <% }) %>
      <% if (drivers.length === 0) { %><p class="muted">Δεν υπάρχουν οδηγοί ακόμη.</p><% } %>
    </div>
  </div>

  <!-- ============ ΕΜΦΑΝΙΣΗ ============ -->
  <% if (user.role === 'admin') { %>
  <div class="tab" id="tab-appearance">
    <div class="card">
      <h2>Branding — Χρώματα & Λογότυπα</h2>
      <form method="post" action="/admin/branding/colors">
        <div class="grid2">
          <div><label>Navy (μπάρα/τίτλοι)</label><input type="color" name="color_navy" value="<%= colors.navy %>" /></div>
          <div><label>Gold (τονισμοί)</label><input type="color" name="color_gold" value="<%= colors.gold %>" /></div>
          <div><label>Teal</label><input type="color" name="color_teal" value="<%= colors.teal %>" /></div>
          <div><label>Indigo</label><input type="color" name="color_indigo" value="<%= colors.indigo %>" /></div>
          <div><label>Deep teal (links)</label><input type="color" name="color_deep" value="<%= colors.deep %>" /></div>
          <div><label>Steel (focus)</label><input type="color" name="color_steel" value="<%= colors.steel %>" /></div>
        </div>
        <button class="btn primary">Αποθήκευση χρωμάτων</button>
      </form>

      <h3>Λογότυπα (PNG/SVG, έως 3MB)</h3>
      <form method="post" action="/admin/branding/logos" enctype="multipart/form-data">
        <div class="grid2">
          <div><label>Λογότυπο (λευκό φόντο · login)</label><input type="file" name="logo" accept="image/*" /></div>
          <div><label>Λογότυπο (σκούρο φόντο · μπάρα)</label><input type="file" name="logo_white" accept="image/*" /></div>
          <div><label>Favicon / εικονίδιο</label><input type="file" name="favicon" accept="image/*" /></div>
        </div>
        <button class="btn primary">Ανέβασμα λογοτύπων</button>
      </form>
      <p class="muted small">Τρέχοντα:
        <a href="/brand/logo" target="_blank">logo</a> ·
        <a href="/brand/logo-white" target="_blank">logo-white</a> ·
        <a href="/brand/favicon" target="_blank">favicon</a>
      </p>
    </div>

    <div class="card">
      <h2>Θέμα εφαρμογής — Εικαστικό (live preview)</h2>
      <form method="post" action="/admin/branding/theme">
        <h3>Χρώματα ανά στοιχείο</h3>
        <div class="grid2">
          <div><label>Μπάρα (φόντο)</label><input type="color" id="header_bg" name="header_bg" value="<%= theme.header_bg %>" oninput="pv()"></div>
          <div><label>Μπάρα (κείμενο)</label><input type="color" id="header_text" name="header_text" value="<%= theme.header_text %>" oninput="pv()"></div>
          <div><label>Τονισμός/γραμμή</label><input type="color" id="accent" name="accent" value="<%= theme.accent %>" oninput="pv()"></div>
          <div><label>Φόντο σελίδας</label><input type="color" id="page_bg" name="page_bg" value="<%= theme.page_bg %>" oninput="pv()"></div>
          <div><label>Φόντο κάρτας</label><input type="color" id="card_bg" name="card_bg" value="<%= theme.card_bg %>" oninput="pv()"></div>
          <div><label>Κείμενο</label><input type="color" id="text" name="text" value="<%= theme.text %>" oninput="pv()"></div>
          <div><label>Κουμπί (φόντο)</label><input type="color" id="primary" name="primary" value="<%= theme.primary %>" oninput="pv()"></div>
          <div><label>Κουμπί (κείμενο)</label><input type="color" id="primary_text" name="primary_text" value="<%= theme.primary_text %>" oninput="pv()"></div>
          <div><label>Σύνδεσμοι</label><input type="color" id="link" name="link" value="<%= theme.link %>" oninput="pv()"></div>
          <div><label>Κεφαλίδα πίνακα (φόντο)</label><input type="color" id="th_bg" name="th_bg" value="<%= theme.th_bg %>" oninput="pv()"></div>
          <div><label>Κεφαλίδα πίνακα (κείμενο)</label><input type="color" id="th_text" name="th_text" value="<%= theme.th_text %>" oninput="pv()"></div>
          <div><label>Footer (κείμενο)</label><input type="color" id="footer_text" name="footer_text" value="<%= theme.footer_text %>" oninput="pv()"></div>
        </div>
        <h3>Τυπογραφία & διάταξη</h3>
        <div class="grid2">
          <div><label>Γραμματοσειρά (font-family)</label>
            <input id="font" name="font" value="<%= theme.font %>" list="fontlist" oninput="pv()">
            <datalist id="fontlist">
              <option value="Arial, Helvetica, sans-serif"><option value="'Segoe UI', system-ui, sans-serif">
              <option value="Georgia, serif"><option value="'Times New Roman', serif"><option value="'Courier New', monospace">
              <option value="Verdana, sans-serif"><option value="Tahoma, sans-serif">
            </datalist>
          </div>
          <div><label>Μέγεθος βάσης (px)</label><input type="number" id="font_size" name="font_size" min="11" max="22" value="<%= theme.font_size %>" oninput="pv()"></div>
          <div><label>Στρογγυλεμένες γωνίες (px)</label><input type="number" id="radius" name="radius" min="0" max="30" value="<%= theme.radius %>" oninput="pv()"></div>
          <div><label>Ύψος λογοτύπου (px)</label><input type="number" id="logo_height" name="logo_height" min="20" max="80" value="<%= theme.logo_height %>" oninput="pv()"></div>
        </div>
        <h3>Κείμενα</h3>
        <div class="grid2">
          <div><label>Τίτλος εφαρμογής</label><input id="app_title" name="app_title" value="<%= theme.app_title %>" oninput="pv()"></div>
          <div><label>Κείμενο footer</label><input id="footer_label" name="footer_label" value="<%= theme.footer_label %>"></div>
          <div><label>Μήνυμα στη σύνδεση</label><input id="login_message" name="login_message" value="<%= theme.login_message %>"></div>
          <div><label class="opt"><input type="checkbox" id="show_title" name="show_title" value="1" <%= theme.show_title==='1'?'checked':'' %> onchange="pv()"> Εμφάνιση τίτλου στη μπάρα</label></div>
        </div>
        <h3>Custom CSS (προχωρημένο)</h3>
        <textarea id="custom_css" name="custom_css" rows="5" style="width:100%;font-family:monospace;font-size:13px" placeholder="π.χ. .topbar{box-shadow:0 2px 6px rgba(0,0,0,.1)}"><%= theme.custom_css %></textarea>
        <p class="muted small">Εφαρμόζεται σε όλη την εφαρμογή μετά την αποθήκευση (δεν εμφανίζεται στην προεπισκόπηση).</p>
        <button class="btn primary">Αποθήκευση θέματος</button>
      </form>

      <h3>Προεπισκόπηση</h3>
      <div id="themePreview" style="border:1px solid var(--line);border-radius:8px;overflow:hidden">
        <div style="background:var(--pv-header-bg);color:var(--pv-header-text);border-bottom:3px solid var(--pv-accent);padding:8px 12px;display:flex;align-items:center;justify-content:space-between">
          <b id="pvTitle" style="letter-spacing:.12em"><%= theme.app_title %></b><span style="font-size:13px">Μενού · Προφίλ</span>
        </div>
        <div style="background:var(--pv-page-bg);padding:14px">
          <div style="background:var(--pv-card-bg);border-radius:var(--pv-radius);padding:14px;color:var(--pv-text);border:1px solid #e3e7ea">
            <p style="margin:0 0 10px">Δείγμα κειμένου με <a id="pvLink" style="text-decoration:underline">σύνδεσμο</a>.</p>
            <button id="pvBtn" style="border:none;border-radius:var(--pv-radius);padding:8px 16px">Κουμπί</button>
            <table style="width:100%;border-collapse:collapse;margin-top:12px;font-size:13px">
              <thead><tr><th id="pvTh" style="padding:6px 8px;text-align:left">Στάση</th><th id="pvTh2" style="padding:6px 8px;text-align:left">Ώρα</th></tr></thead>
              <tbody><tr><td style="border:1px solid #ddd;padding:6px 8px">Γιοφυρο</td><td style="border:1px solid #ddd;padding:6px 8px">05:55</td></tr></tbody>
            </table>
          </div>
          <div id="pvFoot" style="font-size:12px;margin-top:10px">CONDIAN Hotels - All rights reserved 2026</div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <script>
    function promptPw(f){ const p = prompt('Νέος κωδικός:'); if(!p) return false; f.password.value = p; return true; }
    function addBulkRow(){var t=document.getElementById('bulkTpl');if(t)document.getElementById('bulkRows').appendChild(t.content.cloneNode(true));}
    window.ADMIN_STOP = <%- JSON.stringify(editStop || null) %>;
    function pv(){
      var p=document.getElementById('themePreview'); if(!p) return;
      var v=function(id){var e=document.getElementById(id);return e?e.value:'';};
      p.style.setProperty('--pv-header-bg',v('header_bg'));
      p.style.setProperty('--pv-header-text',v('header_text'));
      p.style.setProperty('--pv-accent',v('accent'));
      p.style.setProperty('--pv-page-bg',v('page_bg'));
      p.style.setProperty('--pv-card-bg',v('card_bg'));
      p.style.setProperty('--pv-text',v('text'));
      p.style.setProperty('--pv-radius',(v('radius')||'10')+'px');
      p.style.fontFamily=v('font'); p.style.fontSize=(v('font_size')||'15')+'px';
      var b=document.getElementById('pvBtn'); if(b){b.style.background=v('primary'); b.style.color=v('primary_text');}
      var l=document.getElementById('pvLink'); if(l) l.style.color=v('link');
      [document.getElementById('pvTh'),document.getElementById('pvTh2')].forEach(function(th){if(th){th.style.background=v('th_bg');th.style.color=v('th_text');}});
      var f=document.getElementById('pvFoot'); if(f) f.style.color=v('footer_text');
      var tt=document.getElementById('pvTitle'); if(tt){tt.textContent=v('app_title'); var sh=document.getElementById('show_title'); tt.style.display=(sh&&sh.checked)?'':'none';}
    }
    (function(){
      var tabs=document.querySelectorAll('#adminTabs button');
      var sections=document.querySelectorAll('.tab');
      function activate(name){
        if(!document.getElementById('tab-'+name)) name='overview';
        tabs.forEach(function(b){b.classList.toggle('active', b.dataset.tab===name);});
        sections.forEach(function(s){s.classList.toggle('active', s.id==='tab-'+name);});
        try{localStorage.setItem('adminTab',name);}catch(e){}
      }
      tabs.forEach(function(b){b.addEventListener('click',function(){activate(b.dataset.tab);});});
      var initial='overview';
      if(window.ADMIN_STOP) initial='routes';
      else { try{var t=localStorage.getItem('adminTab'); if(t) initial=t;}catch(e){} }
      activate(initial);
      if(window.ADMIN_STOP){var sf=document.getElementById('stopForm'); if(sf) sf.scrollIntoView();}
      pv();
    })();
  </script>
  <script>
    (function(){
      var list=document.getElementById('routeOrder'); if(!list) return;
      var dragEl=null;
      list.querySelectorAll('li').forEach(function(li){
        li.addEventListener('dragstart',function(){dragEl=li;li.classList.add('dragging');});
        li.addEventListener('dragend',function(){li.classList.remove('dragging');});
      });
      list.addEventListener('dragover',function(e){
        e.preventDefault();
        var els=[].slice.call(list.querySelectorAll('li:not(.dragging)'));
        var after=els.reduce(function(closest,child){
          var box=child.getBoundingClientRect();var offset=e.clientY-box.top-box.height/2;
          if(offset<0&&offset>closest.offset)return{offset:offset,element:child};return closest;
        },{offset:-Infinity}).element;
        if(!dragEl)return; if(after==null)list.appendChild(dragEl);else list.insertBefore(dragEl,after);
      });
      window.moveRow=function(btn,dir){
        var li=btn.closest('li');
        if(dir<0&&li.previousElementSibling)list.insertBefore(li,li.previousElementSibling);
        if(dir>0&&li.nextElementSibling)list.insertBefore(li.nextElementSibling,li);
      };
      window.saveOrder=function(){
        var ids=[].slice.call(list.querySelectorAll('li')).map(function(li){return li.dataset.id;});
        document.getElementById('orderMsg').textContent='Αποθήκευση…';
        fetch('/admin/routes/reorder',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:ids})})
          .then(function(r){return r.json();})
          .then(function(){document.getElementById('orderMsg').textContent='Αποθηκεύτηκε ✓ (θα φανεί μετά από ανανέωση)';})
          .catch(function(){document.getElementById('orderMsg').textContent='Σφάλμα αποθήκευσης';});
      };
    })();
  </script>
