<%- include('partials/header') %>
  <div class="card">
    <h1>Πρόγραμμα παραλαβών</h1>
    <form method="get" action="/driver" class="row">
      <label>Ημερομηνία</label>
      <input type="date" name="date" value="<%= workDate %>" min="<%= minDate %>" onchange="this.form.submit()" />
      <span class="muted"><%= prettyDate(workDate) %></span>
    </form>
    <div class="row" style="margin-top:8px">
      <a class="btn" href="/driver/print?date=<%= workDate %>" target="_blank">Εκτύπωση</a>
      <a class="btn" href="/driver/export.pdf?date=<%= workDate %>">Λήψη PDF</a>
      <a class="btn" href="/driver/export.csv?date=<%= workDate %>">Λήψη CSV</a>
    </div>

    <div class="metrics">
      <div class="metric"><div class="ml">Εργασία</div><div class="mv ok"><%= counts.work %></div></div>
      <div class="metric"><div class="ml">Ρεπό</div><div class="mv"><%= counts.off %></div></div>
      <div class="metric"><div class="ml">Εκκρεμούν</div><div class="mv warn"><%= counts.pending %></div></div>
    </div>

    <div id="map" class="map"></div>
    <% if (!mapsKey) { %><p class="muted small">Πρόσθεσε GOOGLE_MAPS_API_KEY για να εμφανιστεί ο χάρτης.</p><% } %>
  </div>

  <div class="card">
    <h2>Στάσεις & επιβάτες</h2>
    <% if (pickups.length === 0) { %>
      <p class="muted">Καμία δήλωση εργασίας ακόμη.</p>
    <% } else {
      const routesMap = {};
      pickups.forEach(function(p){
        const rk = p.route || '—';
        (routesMap[rk] = routesMap[rk] || []).push(p);
      });
      Object.keys(routesMap).forEach(function(routeName){
        const items = routesMap[routeName];
        const stops = {};
        items.forEach(function(p){
          const sk = (p.stop||'') + '|' + (p.pickup_time||'');
          (stops[sk] = stops[sk] || { stop: p.stop, time: p.pickup_time, people: [] }).people.push(p.person);
        });
    %>
      <div class="routehdr"><span><%= routeName %></span><span class="ln"></span></div>
      <% Object.keys(stops).forEach(function(sk){ var g = stops[sk]; %>
        <div class="stopcard">
          <div class="stopcard-head">
            <span class="stopcard-name">
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.3-7-11a7 7 0 1 1 14 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <%= g.stop || '—' %>
            </span>
            <span class="pill"><%= g.time || '' %></span>
          </div>
          <% g.people.forEach(function(n){ %><div class="person"><span class="dot"></span><%= n %></div><% }) %>
        </div>
      <% }) %>
    <% }) } %>
  </div>

  <div class="card">
    <div class="pendingbox">
      <h2>Δεν δήλωσαν ακόμη (<%= pending.length %>)</h2>
      <% if (pending.length === 0) { %>
        <p class="ok" style="margin:0">Όλο το προσωπικό έχει δηλώσει.</p>
      <% } else { %>
        <% pending.forEach(function(p){ %><div class="person"><span class="dot"></span><%= p.name %></div><% }) %>
      <% } %>
    </div>
  </div>

  <script>window.PICKUPS = <%- JSON.stringify(pickups) %>;</script>
  <% if (mapsKey) { %>
    <script src="/driver-map.js"></script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= mapsKey %>&callback=initDriverMap"></script>
  <% } %>
<%- include('partials/footer') %>
