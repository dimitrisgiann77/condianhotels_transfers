<!DOCTYPE html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/brand.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <link rel="icon" href="/brand/favicon" />
  <meta property="og:title" content="<%= theme.app_title %> — Transfers" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="<%= publicUrl %>/brand/share" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="<%= publicUrl %>/brand/share" />
</head>
<body>
  <header class="topbar">
    <a class="brand-wrap" href="/">
      <img class="brand-logo" src="/brand/favicon" onerror="this.onerror=null;this.src='/logo-mark.svg'" alt="CONDIAN Hotels" />
      <div class="brand"><b><%= theme.app_title %></b></div>
    </a>
    <% if (user) { %>
      <div class="usermenu">
        <button type="button" class="usermenu-btn" onclick="toggleUserMenu(event)">
          <img class="navava" src="/avatar/<%= user.id %>" alt="" />
          <span class="who"><%= user.name %></span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="usermenu-panel" id="userPanel">
          <% if (user.role === 'admin' || user.role === 'superuser') { %>
            <a href="/admin">Διαχείριση</a>
            <a href="/admin/stats">Στατιστικά</a>
            <a href="/driver"><%= t('program') %></a>
          <% } else if (user.role === 'driver') { %>
            <a href="/driver"><%= t('program') %></a>
          <% } else { %>
            <a href="/staff"><%= t('home') %></a>
            <a href="/staff?tab=declare"><%= t('my_declaration') %></a>
            <a href="/feedback"><%= t('evaluation') %></a>
          <% } %>
          <button type="button" class="usermenu-link" onclick="openReport(event)"><%= t('report_issue') %></button>
          <a href="/profile"><%= t('profile') %></a>
          <div class="usermenu-lang"><span class="muted small"><%= t('language') %>:</span> <a href="/lang/el" class="<%= lang==='el'?'lang-on':'' %>">EL</a> · <a href="/lang/en" class="<%= lang==='en'?'lang-on':'' %>">EN</a></div>
          <form method="post" action="/logout"><button type="submit" class="usermenu-link"><%= t('logout') %></button></form>
        </div>
      </div>
      <!-- Report issue modal -->
      <div class="rpt-backdrop" id="rptBackdrop" onclick="if(event.target===this)closeReport()">
        <div class="rpt-modal" role="dialog" aria-modal="true">
          <h3><%= t('report_title') %></h3>
          <p class="muted small"><%= t('report_intro') %></p>
          <form method="post" action="/report">
            <label><%= t('report_area') %></label>
            <select name="area">
              <option value="general"><%= t('area_general') %></option>
              <option value="pickup"><%= t('area_pickup') %></option>
              <option value="schedule"><%= t('area_schedule') %></option>
              <option value="account"><%= t('area_account') %></option>
              <option value="notify"><%= t('area_notify') %></option>
              <option value="map"><%= t('area_map') %></option>
              <option value="other"><%= t('area_other') %></option>
            </select>
            <label><%= t('report_message') %></label>
            <textarea name="message" rows="4" required></textarea>
            <div class="rpt-actions">
              <button type="button" class="btn ghost" onclick="closeReport()"><%= t('report_cancel') %></button>
              <button type="submit" class="btn"><%= t('report_submit') %></button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  </header>
  <script>
    function toggleUserMenu(e){ e.stopPropagation(); var p=document.getElementById('userPanel'); if(p) p.classList.toggle('open'); }
    function openReport(e){ if(e){e.stopPropagation();} var p=document.getElementById('userPanel'); if(p)p.classList.remove('open'); var b=document.getElementById('rptBackdrop'); if(b)b.classList.add('open'); }
    function closeReport(){ var b=document.getElementById('rptBackdrop'); if(b)b.classList.remove('open'); }
    document.addEventListener('DOMContentLoaded', function(){
      if(/[?&]reported=1/.test(location.search)){
        var t=document.createElement('div'); t.className='rpt-toast'; t.textContent=<%- JSON.stringify(t('report_sent')) %>;
        document.body.appendChild(t); setTimeout(function(){t.classList.add('show');},30);
        setTimeout(function(){t.classList.remove('show');setTimeout(function(){t.remove();},400);},4000);
        try{ history.replaceState(null,'',location.pathname+location.search.replace(/([?&])reported=1&?/,'$1').replace(/[?&]$/,'')); }catch(e){}
      }
    });
    document.addEventListener('click', function(){ var p=document.getElementById('userPanel'); if(p) p.classList.remove('open'); });
  </script>
  <main class="container">
