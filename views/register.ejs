<%- include('partials/header') %>
  <div class="card" style="max-width:560px;margin:5vh auto">
    <h1><%= t('register_title') %></h1>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <% if (!enabled) { %>
      <p class="muted"><%= t('reg_disabled') %></p>
      <a class="btn" href="/login"><%= t('have_account') %></a>
    <% } else { %>
    <p class="muted small">Συμπλήρωσε τα στοιχεία σου. Ο λογαριασμός θα ενεργοποιηθεί μόλις τον εγκρίνει η διοίκηση.</p>
    <form method="post" action="/register">
      <div class="grid2">
        <div><label><%= t('lastname') %> *</label><input name="last_name" required /></div>
        <div><label><%= t('firstname') %> *</label><input name="first_name" required /></div>
        <div><label><%= t('username') %> *</label><input name="username" required /></div>
        <div><label><%= t('password') %> *</label><input name="password" type="password" required /></div>
        <div><label><%= t('email') %> *</label><input name="email" type="email" required /></div>
        <div><label><%= t('phone') %> *</label><input name="phone" required /></div>
      </div>
      <label><%= t('default_route') %></label>
      <select name="favorite_route_id">
        <option value="">— Κανένα —</option>
        <% routes.forEach(function(r){ %><option value="<%= r.id %>"><%= r.name %></option><% }) %>
      </select>
      <label><%= t('reg_code') %> *</label>
      <input name="code" required placeholder="Δόθηκε από τη διοίκηση" />
      <button class="btn primary"><%= t('register_btn') %></button>
      <a class="btn" href="/login"><%= t('have_account') %></a>
    </form>
    <% } %>
  </div>
<%- include('partials/footer') %>
