<%- include('partials/header') %>
  <% if (saved) { %><div class="alert ok"><%= t('decl_saved') %></div><% } %>
  <% if (typeof msg !== "undefined" && msg) { %><div class="alert ok"><%= msg %></div><% } %>
  <% if (error === 'full') { %><div class="alert err"><%= t('route_full') %></div><% } %>

  <div class="tabs" id="staffTabs">
    <button type="button" data-tab="cal" class="active"><%= t('calendar') %></button>
    <button type="button" data-tab="declare"><%= t('declare') %></button>
    <button type="button" data-tab="mine"><%= t('my_declarations') %></button>
  </div>

  <!-- ΗΜΕΡΟΛΟΓΙΟ -->
  <div class="tab active" id="tab-cal">
    <div class="card">
      <h1><%= t('my_program') %></h1>
      <%- include('partials/weekcal') %>
      <p class="muted small"><%= t('click_day') %></p>
    </div>
  </div>

  <!-- ΔΗΛΩΣΗ -->
  <div class="tab" id="tab-declare">
    <div class="card">
      <h1><%= t('shift_declaration') %></h1>
      <form method="get" action="/staff" class="row">
        <input type="hidden" name="tab" value="declare" />
        <label>Ημερομηνία</label>
        <input type="date" name="date" value="<%= workDate %>" min="<%= minDate %>" onchange="this.form.submit()" />
        <span class="muted"><%= prettyDate(workDate) %></span>
      </form>

      <form method="post" action="/staff" id="declForm">
        <input type="hidden" name="work_date" value="<%= workDate %>" />
        <input type="hidden" name="status" value="work" />
        <div id="workFields">
          <label><%= t('route') %></label>
          <select name="route_id" id="routeSel" onchange="fillStops()">
            <option value=""><%= t('choose_route') %></option>
            <% routes.forEach(function(r){ var used=(usage[r.id]||0); var mineHere=(mine&&mine.status==='work'&&mine.route_id===r.id); var rem=r.capacity-used+(mineHere?1:0); var full=rem<=0; %>
              <option value="<%= r.id %>" <%= (mine && mine.route_id===r.id) || (!mine && favorite===r.id && !full) ? 'selected':'' %> <%= full && !mineHere ? 'disabled':'' %>><%= r.name %><%= full ? ' — ' + t('full') : '' %></option>
            <% }) %>
          </select>
          <label><%= t('stop') %></label>
          <select name="stop_id" id="stopSel" onchange="showTime()"><option value=""><%= t('choose_stop') %></option></select>
          <div class="timebox"><%= t('pickup_time') %>: <b id="timeOut">—</b></div>
          <div class="timebox"><%= t('available_seats') %>: <b id="seatsOut">—</b></div>
        </div>
        <button class="btn primary" type="submit"><%= t('submit_decl') %></button>
      </form>
    </div>


  </div>

  <!-- ΟΙ ΔΗΛΩΣΕΙΣ ΜΟΥ -->
  <div class="tab" id="tab-mine">
    <div class="card">
      <h2><%= t('my_declarations') %></h2>
      <% if (!myDeclarations || myDeclarations.length === 0) { %>
        <p class="muted"><%= t('no_my_decl') %></p>
      <% } else { %>
        <% myDeclarations.forEach(function(d){ var ds = String(d.work_date).slice(0,10); %>
          <div class="decl">
            <div>
              <div class="d-date"><%= prettyDate(ds) %></div>
              <div class="d-meta"><% if (d.status==='work') { %><%= d.route || '' %><%= d.stop ? ' · ' + d.stop : '' %><%= d.pickup_time ? ' · ' + d.pickup_time : '' %><% } else { %><%= t('off') %><% } %></div>
            </div>
            <span class="badge <%= d.status==='work'?'work':'off' %>"><%= d.status==='work'?t('work'):t('off') %></span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <script>
    const ROUTES = <%- JSON.stringify(routes) %>;
    const MINE = <%- JSON.stringify(mine || null) %>;
    const USAGE = <%- JSON.stringify(usage || {}) %>;
    const FAVORITE = <%- JSON.stringify(favorite || null) %>;
    const FAVORITE_STOP = <%- JSON.stringify(favoriteStop || null) %>;
    const T_CHOOSE_STOP = "<%= t('choose_stop') %>";
    function showSeats(){
      const rid=document.getElementById('routeSel').value;const r=ROUTES.find(x=>String(x.id)===String(rid));const out=document.getElementById('seatsOut');
      if(!r){out.textContent='—';return;}
      const used=USAGE[r.id]||0;const mineHere=MINE&&MINE.status==='work'&&String(MINE.route_id)===String(r.id);
      const rem=Math.max(0,r.capacity-used+(mineHere?1:0));out.textContent=rem+' / '+r.capacity+(rem===0?' (πλήρες)':'');
    }
    function fillStops(pre){
      const rid=document.getElementById('routeSel').value;const sel=document.getElementById('stopSel');sel.innerHTML='<option value="">'+T_CHOOSE_STOP+'</option>';
      const r=ROUTES.find(x=>String(x.id)===String(rid));
      if(r)r.stops.forEach(s=>{const o=document.createElement('option');o.value=s.id;o.textContent=s.name+(s.pickup_time?' — '+s.pickup_time:'');o.dataset.time=s.pickup_time||'';if(pre&&String(pre)===String(s.id))o.selected=true;sel.appendChild(o);});
      showTime();showSeats();
    }
    function showTime(){const sel=document.getElementById('stopSel');const t=sel.options[sel.selectedIndex]&&sel.options[sel.selectedIndex].dataset.time;document.getElementById('timeOut').textContent=t||'—';}
    (function init(){
      if (MINE && MINE.route_id) { document.getElementById('routeSel').value=MINE.route_id; fillStops(MINE.stop_id); }
      else if (FAVORITE) { document.getElementById('routeSel').value=FAVORITE; fillStops(FAVORITE_STOP); }
      var tabs=document.querySelectorAll('#staffTabs button');var secs=document.querySelectorAll('.tab');
      function act(n){tabs.forEach(b=>b.classList.toggle('active',b.dataset.tab===n));secs.forEach(s=>s.classList.toggle('active',s.id==='tab-'+n));}
      tabs.forEach(b=>b.addEventListener('click',()=>act(b.dataset.tab)));
      var qp=new URLSearchParams(location.search);var t=qp.get('tab');
      if(!t){ t=(qp.has('saved')||qp.has('error')||qp.has('msg'))?'declare':'cal'; }
      act(t);
    })();
  </script>
<%- include('partials/footer') %>
