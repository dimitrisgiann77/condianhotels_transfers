<%- include('partials/header') %>
  <% if (saved) { %><div class="alert ok"><%= t('decl_saved') %></div><% } %>
  <% if (typeof msg !== "undefined" && msg) { %><div class="alert ok"><%= msg %></div><% } %>
  <% if (error === 'full') { %><div class="alert err"><%= t('route_full') %></div><% } %>

  <div class="tabs" id="staffTabs">
    <button type="button" data-tab="cal" class="active"><%= t('calendar') %></button>
    <button type="button" data-tab="declare"><%= t('declare') %></button>
    <button type="button" data-tab="mine"><%= t('my_declarations') %></button>
  </div>

  <!-- ΗΜΕΡΟΛΟΓΙΟ -->
  <div class="tab active" id="tab-cal">
    <div class="card">
      <h1><%= t('my_program') %></h1>
      <%- include('partials/weekcal') %>
      <p class="muted small"><%= t('click_day') %></p>
    </div>
  </div>

  <!-- ΔΗΛΩΣΗ -->
  <div class="tab" id="tab-declare">
    <div class="card">
      <h1><%= t('shift_declaration') %></h1>
      <form method="post" action="/staff/multi" id="declForm">
        <input type="hidden" name="status" value="work" />
        <input type="hidden" name="route_id" id="routeInput" value="<%= mine && mine.route_id ? mine.route_id : '' %>" />
        <input type="hidden" name="stop_id" id="stopInput" value="<%= mine && mine.stop_id ? mine.stop_id : '' %>" />

        <div class="step-label"><%= t('days_label') %></div>
        <p class="muted small"><%= t('days_hint') %></p>
        <div class="daychips" id="dayChips">
          <% multiDates.forEach(function(d){ %>
            <label class="daychip <%= d.checked?'on':'' %> <%= d.declared?'declared':'' %>">
              <input type="checkbox" name="work_dates" value="<%= d.date %>" <%= d.checked?'checked':'' %> onchange="this.closest('.daychip').classList.toggle('on',this.checked)" />
              <span class="dc-day"><%= d.dayName %></span>
              <span class="dc-num"><%= d.num %></span>
            </label>
          <% }) %>
        </div>

        <p class="muted small" style="margin-top:14px"><%= t('choose_on_map') %></p>
        <div id="pickMap" class="map"></div>
        <div id="pickSummary" class="pick-summary"><span class="muted"><%= t('choose_on_map') %></span></div>

        <details class="pick-fallback">
          <summary><%= t('or_list') %></summary>
          <label><%= t('stop') %></label>
          <select id="fbPoint" onchange="fbFillSvc()"><option value=""><%= t('choose_stop') %></option></select>
          <label><%= t('route') %></label>
          <select id="fbSvc" onchange="fbPick()"><option value=""><%= t('choose_route') %></option></select>
        </details>

        <button class="btn primary" type="submit" id="declSubmit"><%= t('submit_decl') %></button>
      </form>
    </div>
  </div>

  <!-- ΟΙ ΔΗΛΩΣΕΙΣ ΜΟΥ -->
  <div class="tab" id="tab-mine">
    <div class="card">
      <h2><%= t('my_declarations') %></h2>
      <% if (!myDeclarations || myDeclarations.length === 0) { %>
        <p class="muted"><%= t('no_my_decl') %></p>
      <% } else { %>
        <% myDeclarations.forEach(function(d){ var ds = String(d.work_date).slice(0,10); %>
          <div class="decl">
            <div>
              <div class="d-date"><%= prettyDate(ds) %></div>
              <div class="d-meta"><% if (d.status==='work') { %><% if (d.destination) { %><b><%= d.destination %></b> · <% } %><%= d.route || '' %><%= d.stop ? ' · 📍 ' + d.stop : '' %><%= d.pickup_time ? ' · ' + d.pickup_time : '' %><% } else { %><%= t('off') %><% } %></div>
            </div>
            <div class="decl-actions">
              <a class="btn small" href="/staff?tab=declare&date=<%= ds %>"><%= t('edit') %></a>
              <form method="post" action="/staff/delete" class="inline" onsubmit="return confirm('<%= t('confirm_delete') %>')">
                <input type="hidden" name="work_date" value="<%= ds %>" />
                <button class="btn small danger" type="submit"><%= t('delete') %></button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <script src="/pickup-map.js"></script>
  <script>
    const MAP_POINTS = <%- JSON.stringify(mapPoints || []) %>;
    const USAGE = <%- JSON.stringify(usage || {}) %>;
    const MINE = <%- JSON.stringify(mine || null) %>;
    const T = { full: "<%= t('full') %>", seats: "<%= t('seats_word') %>", choose:"<%= t('choose_on_map') %>", route:"<%= t('choose_route') %>", stop:"<%= t('choose_stop') %>" };

    function svcByStop(stopId){ for(const p of MAP_POINTS){ for(const s of (p.services||[])){ if(String(s.stopId)===String(stopId)) return {point:p, svc:s}; } } return null; }
    function seatsOf(svc){ const used=USAGE[svc.routeId]||0; const mineHere=MINE&&MINE.stop_id&&String(MINE.stop_id)===String(svc.stopId); return Math.max(0,(svc.capacity||8)-used+(mineHere?1:0)); }
    function setSummary(stopId){
      const box=document.getElementById('pickSummary'); const f=svcByStop(stopId);
      if(!f){ box.innerHTML='<span class="muted">'+T.choose+'</span>'; return; }
      const s=f.svc; const seats=seatsOf(s);
      box.innerHTML='<div class="ps-name">📍 '+esc(f.point.name)+'</div><div class="ps-meta">'+(s.destination?'<b>'+esc(s.destination)+'</b> · ':'')+esc(s.routeName)+' — <b>'+esc(s.time||'')+'</b> · '+seats+' '+T.seats+'</div><button type="button" class="btn small" onclick="clearSel()">'+"<%= t('clear_sel') %>"+'</button>';
    }
    function esc(x){return String(x==null?'':x).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
    function select(routeId, stopId){
      document.getElementById('routeInput').value=routeId||'';
      document.getElementById('stopInput').value=stopId||'';
      setSummary(stopId);
      // sync fallback
      const f=svcByStop(stopId);
      if(f){ const fp=document.getElementById('fbPoint'); fp.value=f.point.key; fbFillSvc(); document.getElementById('fbSvc').value=String(stopId); }
    }
    function clearSel(){ document.getElementById('routeInput').value=''; document.getElementById('stopInput').value=''; setSummary(null); var fp=document.getElementById('fbPoint'); if(fp)fp.value=''; fbFillSvc(); }

    // fallback list
    function fbInit(){
      const fp=document.getElementById('fbPoint');
      MAP_POINTS.forEach(p=>{ const o=document.createElement('option'); o.value=p.key; o.textContent=p.name; fp.appendChild(o); });
    }
    function fbFillSvc(){
      const fp=document.getElementById('fbPoint').value; const fs=document.getElementById('fbSvc'); fs.innerHTML='<option value="">'+T.route+'</option>';
      const p=MAP_POINTS.find(x=>x.key===fp); if(!p)return;
      p.services.forEach(s=>{ const seats=seatsOf(s); const o=document.createElement('option'); o.value=s.stopId; o.textContent=(s.destination?s.destination+' · ':'')+s.routeName+' — '+(s.time||'')+' · '+seats+' '+T.seats+(seats<=0?' ('+T.full+')':''); if(seats<=0)o.disabled=true; o.dataset.r=s.routeId; fs.appendChild(o); });
    }
    function fbPick(){ const fs=document.getElementById('fbSvc'); const opt=fs.options[fs.selectedIndex]; if(!opt||!opt.value){ return; } select(opt.dataset.r, opt.value); }

    let pickMap=null;
    (function init(){
      fbInit();
      if (MINE && MINE.stop_id) setSummary(MINE.stop_id); else setSummary(null);
      var tabs=document.querySelectorAll('#staffTabs button');var secs=document.querySelectorAll('.tab');
      function act(n){
        tabs.forEach(b=>b.classList.toggle('active',b.dataset.tab===n));
        secs.forEach(s=>s.classList.toggle('active',s.id==='tab-'+n));
        if(n==='declare'){ if(!pickMap){ pickMap=createPickupMap({elId:'pickMap', points:MAP_POINTS, mode:'select', usage:USAGE, mineStopId:MINE&&MINE.stop_id, seatsWord:T.seats, fullWord:T.full, onSelect:select}); } else pickMap.refresh(); }
      }
      tabs.forEach(b=>b.addEventListener('click',()=>act(b.dataset.tab)));
      var qp=new URLSearchParams(location.search);var t=qp.get('tab');
      if(!t){ t=(qp.has('saved')||qp.has('error'))?'declare':'cal'; }
      act(t);
    })();
  </script>
<%- include('partials/footer') %>
